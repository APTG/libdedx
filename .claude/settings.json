{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cmake --preset:*)",
      "Bash(cmake --build:*)",
      "Bash(cmake -S:*)",
      "Bash(ctest:*)",
      "Bash(cmake --install:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(valgrind:*)",
      "Bash(python3 tools/dat2c.py:*)",
      "Bash(python3 tools/pdf2dat.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
